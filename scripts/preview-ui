#!/usr/bin/env python3
"""Local control UI for Linux Preview.

Serves a single page on 127.0.0.1:6081 to start and stop fixture dev
servers of every catalog type and to add and remove test containers in
the preview's isolated engine. All actions run through
scripts/preview-fixture.sh, so the UI and the terminal share one code
path. The page shows the native application preview beside the workload
controls.
"""
import json
import re
import subprocess
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
FIXTURE = REPO / "scripts" / "preview-fixture.sh"
NAME = "linux-preview-poc"
HOST, PORT = "127.0.0.1", 6081
CONTAINER_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$")


def run(*args, timeout=60):
    try:
        r = subprocess.run(
            [str(FIXTURE), *args], capture_output=True, text=True, timeout=timeout
        )
    except subprocess.TimeoutExpired:
        return {"ok": False, "output": f"timed out: {args[0]} {args[1:3]}"}
    return {"ok": r.returncode == 0, "output": (r.stdout + r.stderr).strip()}


def types():
    r = subprocess.run([str(FIXTURE), "types"], capture_output=True, text=True)
    rows = []
    for line in r.stdout.splitlines():
        parts = line.split(None, 2)
        if len(parts) == 3:
            rows.append({"type": parts[0], "port": parts[1], "command": parts[2]})
    return rows


def containers():
    r = run("docker", "ls")
    rows = []
    for line in r["output"].splitlines():
        parts = line.split("\t")
        if len(parts) == 3:
            rows.append({"name": parts[0], "image": parts[1], "status": parts[2]})
    return rows


def listening_ports():
    r = subprocess.run(
        ["podman", "exec", NAME, "cat", "/proc/net/tcp", "/proc/net/tcp6"],
        capture_output=True,
        text=True,
    )
    ports = set()
    for line in r.stdout.splitlines():
        fields = line.split()
        if len(fields) > 3 and fields[3] == "0A":
            ports.add(int(fields[1].rsplit(":", 1)[1], 16))
    return ports


def state():
    rows = types()
    ports = listening_ports()
    for row in rows:
        row["active"] = int(row["port"]) in ports
    return {
        "online": bool(ports),
        "activeCount": sum(row["active"] for row in rows),
        "types": rows,
        "containers": containers(),
    }


PAGE = """<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>DistroStage workbench</title>
<style>
  :root { color-scheme: dark; }
  * { box-sizing: border-box; }
  body { margin: 0; font: 14px/1.45 system-ui, sans-serif;
         background: #111318; color: #e4e7ec; }
  header { height: 54px; display: flex; align-items: center; justify-content: space-between;
           padding: 0 18px; border-bottom: 1px solid #2b3038; }
  h1 { font-size: 15px; margin: 0; } h2 { font-size: 13px; margin: 20px 0 8px; }
  main { display: grid; grid-template-columns: minmax(0, 1fr) 420px;
         height: calc(100vh - 54px); }
  .preview { padding: 14px; min-width: 0; }
  iframe { width: 100%; height: 100%; border: 1px solid #303640; border-radius: 8px;
           background: #0a0b0e; }
  aside { overflow-y: auto; padding: 4px 18px 24px;
          border-left: 1px solid #2b3038; background: #171a20; }
  .summary { color: #a6adb8; font-size: 12px; }
  .summary strong { color: #e4e7ec; font-variant-numeric: tabular-nums; }
  table { border-collapse: collapse; width: 100%; }
  td, th { padding: 7px 4px; border-bottom: 1px solid #282d35; text-align: left; }
  th { color: #858d9a; font-size: 11px; font-weight: 600; }
  td.cmd, th.port { color: #8d95a2; font-family: ui-monospace, monospace;
                    font-size: 11px; font-variant-numeric: tabular-nums; }
  .dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%;
         background: #4b515c; margin-right: 7px; }
  .dot.active { background: #68d391; box-shadow: 0 0 0 3px #68d39118; }
  button { background: #292e36; color: #e4e7ec; border: 1px solid #3b424d;
           border-radius: 5px; padding: 4px 9px; cursor: pointer; }
  button:hover { background: #343b45; }
  button:focus-visible, input:focus-visible { outline: 2px solid #7aa2f7;
                                              outline-offset: 2px; }
  button:disabled { cursor: default; opacity: .4; }
  input { background: #1c1f24; color: #ddd; border: 1px solid #3a414b;
          border-radius: 5px; padding: 5px 8px; width: 12em; }
  .log { background: #101216; border: 1px solid #262a31; border-radius: 4px;
         padding: 8px; font: 12px ui-monospace, monospace; white-space: pre-wrap;
         min-height: 4em; max-height: 10em; overflow-y: auto; color: #b8c0cc; }
  .row { display: flex; gap: 8px; align-items: center; margin: 8px 0; }
  @media (max-width: 900px) {
    main { grid-template-columns: 1fr; height: auto; }
    .preview { height: 62vh; }
    aside { border-left: 0; border-top: 1px solid #2b3038; }
  }
</style>
</head>
<body>
<header>
  <h1>DistroStage</h1>
  <div class="summary"><strong id="count">0</strong> active workloads</div>
</header>
<main>
  <section class="preview" aria-label="Native application preview">
    <iframe title="Native application preview"
      src="http://127.0.0.1:6080/vnc.html?autoconnect=1&resize=scale"></iframe>
  </section>
  <aside>
    <h2>Dev servers</h2>
    <table id="types">
      <tr><th>Status</th><th>Type</th><th class="port">Port</th><th>Actions</th></tr>
    </table>

    <h2>Test containers</h2>
    <div class="row">
      <input id="cname" aria-label="Container name" placeholder="container name" value="probe">
      <button onclick="containerStart(this)">Add container</button>
    </div>
    <table id="cts"><tr><th>Name</th><th>Status</th><th></th></tr></table>

    <h2>Activity</h2>
    <div class="log" id="log" role="status" aria-live="polite">Ready.</div>
  </aside>
</main>

<script>
const $ = (id) => document.getElementById(id);
const log = (text) => { $('log').textContent = text + "\\n" + $('log').textContent; };
let renderedState = '';

async function api(path, body) {
  const r = await fetch(path, {
    method: body ? 'POST' : 'GET',
    headers: {'Content-Type': 'application/json'},
    body: body ? JSON.stringify(body) : undefined,
  });
  return r.json();
}

async function refresh() {
  const s = await api('/api/state');
  $('count').textContent = s.activeCount + s.containers.length;
  const nextState = JSON.stringify([
    s.types.map(x => [x.type, x.active]),
    s.containers.map(x => [x.name, x.image]),
  ]);
  if (nextState === renderedState) return;
  renderedState = nextState;
  const t = $('types');
  while (t.rows.length > 1) t.deleteRow(-1);
  for (const x of s.types) {
    const tr = document.createElement('tr');
    tr.innerHTML = '<td><span class="dot ' + (x.active ? 'active' : '') +
      '"></span>' + (x.active ? 'active' : 'stopped') + '</td><td>' + x.type +
      '</td><td class="cmd">' + x.port + '</td>';
    const td = document.createElement('td');
    const start = document.createElement('button');
    start.textContent = 'start';
    start.disabled = x.active;
    start.onclick = () => act('/api/start', {type: x.type}, start);
    const stop = document.createElement('button');
    stop.textContent = 'stop';
    stop.disabled = !x.active;
    stop.onclick = () => act('/api/stop', {type: x.type}, stop);
    td.append(start, ' ', stop);
    tr.append(td);
    $('types').append(tr);
  }
  const c = $('cts');
  while (c.rows.length > 1) c.deleteRow(-1);
  if (!s.containers.length) {
    const tr = document.createElement('tr');
    tr.innerHTML = '<td colspan="3" class="cmd">No test containers.</td>';
    c.append(tr);
  }
  for (const x of s.containers) {
    const tr = document.createElement('tr');
    tr.innerHTML = '<td>' + x.name + '</td><td>' + x.status + '</td>';
    const td = document.createElement('td');
    const rm = document.createElement('button');
    rm.textContent = 'remove';
    rm.onclick = () => act('/api/container/stop', {name: x.name}, rm);
    td.append(rm);
    tr.append(td);
    c.append(tr);
  }
}

async function act(path, body, button) {
  const label = body.type ? body.type : body.name;
  if (button) button.disabled = true;
  log('$ ' + path.split('/').pop() + ' ' + label);
  try {
    const r = await api(path, body);
    log((r.ok ? 'ok: ' : 'FAILED: ') + r.output);
  } catch (error) {
    log('FAILED: ' + error.message);
  } finally {
    refresh();
  }
}

async function containerStart(button) {
  const name = $('cname').value.trim() || 'probe';
  button.disabled = true;
  log('$ docker start ' + name);
  try {
    const r = await api('/api/container/start', {name});
    log((r.ok ? 'ok: ' : 'FAILED: ') + r.output);
  } catch (error) {
    log('FAILED: ' + error.message);
  } finally {
    button.disabled = false;
    refresh();
  }
}

refresh();
setInterval(refresh, 5000);
</script>
</body>
</html>
"""


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass

    def _send(self, code, body, ctype="application/json"):
        data = body if isinstance(body, bytes) else json.dumps(body).encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if self.path == "/":
            self._send(200, PAGE.encode(), "text/html; charset=utf-8")
        elif self.path == "/api/state":
            self._send(200, state())
        else:
            self._send(404, {"error": "not found"})

    def do_POST(self):
        length = int(self.headers.get("Content-Length", 0))
        if length > 4096:
            return self._send(413, {"ok": False, "output": "request too large"})
        try:
            body = json.loads(self.rfile.read(length) or b"{}")
        except json.JSONDecodeError:
            return self._send(400, {"ok": False, "output": "invalid JSON"})
        known_types = {row["type"] for row in types()}
        if self.path == "/api/start":
            if body.get("type") not in known_types:
                return self._send(400, {"ok": False, "output": "unknown server type"})
            args = ["start", body["type"]]
            if body.get("port"):
                args.append(str(body["port"]))
            self._send(200, run(*args, timeout=90))
        elif self.path == "/api/stop":
            if body.get("type") not in known_types:
                return self._send(400, {"ok": False, "output": "unknown server type"})
            self._send(200, run("stop", body["type"]))
        elif self.path == "/api/container/start":
            name = body.get("name", "probe")
            if not CONTAINER_NAME.fullmatch(name):
                return self._send(400, {"ok": False, "output": "invalid container name"})
            self._send(200, run("docker", "start", name, timeout=300))
        elif self.path == "/api/container/stop":
            name = body.get("name", "")
            if not CONTAINER_NAME.fullmatch(name):
                return self._send(400, {"ok": False, "output": "invalid container name"})
            self._send(200, run("docker", "stop", name))
        else:
            self._send(404, {"error": "not found"})


if __name__ == "__main__":
    print(f"Linux Preview control UI: http://{HOST}:{PORT}/")
    ThreadingHTTPServer((HOST, PORT), Handler).serve_forever()
